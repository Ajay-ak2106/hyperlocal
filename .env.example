# NammaRescue - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development
DEMO_MODE=true

# Supabase Configuration (Optional for initial local demo, built-in SQLite/WebSocket engine operates seamlessly)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional External AI & Voice Keys (Optional fallback to Web Speech API & Local Heuristic AI)
AI_API_KEY=
VOICE_API_KEY=
PAYMENT_API_KEY=
